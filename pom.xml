            <!-- 同一个库会出现的坐标全部直接固定到同一版本（以下 okhttp、swagger 两族同此规则）：
                 DM 按坐标固定版本，不识别"不同坐标是同一个库/装同一批类"，只固定其中一个坐标时，其余坐标的版本落到
                 导入的 BOM 或传递依赖上。直接条目优先级高于一切导入的 BOM（含 Spring Cloud），与声明顺序无关，
                 下游只有在自己 pom 里再写一条才能覆盖。 -->
            <!-- springdoc 与它的 swagger 引擎必须用 springdoc 配套版本（3.2.0 配 swagger 2.2.55），升级 springdoc 时同步改
                 swagger.version。uw-* 模块用 swagger-annotations，springdoc 用 *-jakarta，注解与引擎必须同版本：260714 只固定了
                 swagger-annotations 2.2.50，springdoc 3.0.3 自带引擎为 2.2.47，错配致查询参数输出错误的空默认值。
                 同版本下两种风格的注解类字节一致。 -->
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>3.2.0</version>
            </dependency>
