<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <packaging>jar</packaging>
    <artifactId>uw-common-app</artifactId>
    <version>${uw-common-app.version}</version>
    <name>uw-common-app</name>
    <description>uw-common-app</description>
    <parent>
        <groupId>pub.xili</groupId>
        <artifactId>uw-base</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <dependencies>
        <!-- ============ Spring 生态 ============ -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-loadbalancer</artifactId>
        </dependency>
        <!-- ============ 自研框架 uw-* ============ -->
        <dependency>
            <groupId>pub.xili</groupId>
            <artifactId>uw-common</artifactId>
        </dependency>
        <dependency>
            <groupId>pub.xili</groupId>
            <artifactId>uw-dao</artifactId>
        </dependency>
        <dependency>
            <groupId>pub.xili</groupId>
            <artifactId>uw-auth-service</artifactId>
        </dependency>
        <dependency>
            <groupId>pub.xili</groupId>
            <artifactId>uw-nacos-client</artifactId>
        </dependency>
        <!-- ============ 测试依赖 ============ -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- flatten：声明激活 pluginManagement 的配置（oss+direct standalone 发布形态），把 ${revision}
                 拍平到 install/deploy 的 pom。 -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>