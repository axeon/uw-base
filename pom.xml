    <build>
        <pluginManagement>
            <plugins>
                <!-- flatten（pluginManagement）：仅对显式声明本插件的模块生效——uw-base 19 个子模块声明后
                     得此配置，叶子 jar 以 standalone 形态发布（oss+direct：无 parent 引用、依赖版本全内联、
                     optional/scope 语义保留、licenses/developers/scm 齐全），Central 消费方零 parent 链。
                     下游项目（uw-ops-center 等）不声明本插件即不执行，不再被波及生成 .flattened-pom.xml。 -->
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>flatten-maven-plugin</artifactId>
                    <version>1.8.0</version>
                    <configuration>
                        <updatePomFile>true</updatePomFile>
                        <flattenMode>oss</flattenMode>
                        <flattenDependencyMode>direct</flattenDependencyMode>
                    </configuration>
                    <executions>
                        <execution>
                            <id>flatten</id>
                            <phase>process-resources</phase>
                            <goals>
                                <goal>flatten</goal>
                            </goals>
                        </execution>
                        <execution>
                            <id>flatten.clean</id>
                            <phase>clean</phase>
                            <goals>
                                <goal>clean</goal>
                            </goals>
                        </execution>
                        <!-- deploy 之后自动清掉 .flattened-pom.xml：同阶段内默认的 deploy 插件先执行，清理发生在发布之后。
                             不能绑到 install 阶段——mvn deploy 会先走 install 阶段，提前删掉后 deploy 插件找不到拍平的 pom
                             （"The POM for project could not be attached"）。install/compile/package 构建后文件保留，mvn clean 清理。 -->
                        <execution>
                            <id>flatten.clean-after-deploy</id>
                            <phase>deploy</phase>
                            <goals>
                                <goal>clean</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <!-- 根 pom 自身声明并覆盖模式：resolveCiFriendliesOnly（仅解析 ${revision}，parent/DM/modules/build
                 全保）。本 pom 被 uw-ops-center 等下游当 parent 引用，DM 是下游版本解析的唯一来源——
                 oss 形态对根 pom 是残缺产物（仅剩坐标+licenses/developers/scm，丢 parent/DM/modules），
                 261108 实测 1330B 产物本地 install 污染 ~/.m2 致下游 13 依赖 version missing 构建断裂。
                 standalone 只属于叶子模块（走 pluginManagement 配置）。
                 inherited=false：本声明不向子模块/下游传播——否则 parent plugins 的显式配置会覆盖
                 pluginManagement，子模块拿不到 oss+direct、下游还会被波及生成 .flattened-pom.xml；
                 根 pom 自身不受影响。Central 发布根 pom 亦走本形态（licenses/developers/scm 源 pom 已具）。 -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
                <inherited>false</inherited>
                <configuration>
                    <flattenMode>resolveCiFriendliesOnly</flattenMode>
                    <!-- inherited=插件默认语义（依赖版本按 DM 标准解析，pom 结构不动），显式压掉 pluginManagement 的 direct -->
                    <flattenDependencyMode>inherited</flattenDependencyMode>
                </configuration>
            </plugin>
            <!-- 构建期防线：同名类出现在多个构件且内容不同即失败（okhttp 4.x/5.x 双份 okhttp3.Call、javax 与 jakarta 版
                 swagger-core 等，单测拦不住），弥补 DM 只按坐标固定版本、看不到跨坐标同名类的盲区。
                 随继承生效于 19 个子模块与以本 pom 为 parent 的下游，validate 阶段执行（版本由 Spring Boot 管理）。
                 范围=进 Spring Boot fat jar 的 compile/runtime/provided；字节码完全相同的重复放行。重复应从源头删除或
                 exclusion 排除，ignoreClasses 只登记设计如此的同名副本（逐类写明原因）。临时跳过：-Denforcer.skip=true。 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <dependencies>
                    <dependency>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>extra-enforcer-rules</artifactId>
                        <version>1.12.1</version>
                    </dependency>
                </dependencies>
                <executions>
                    <execution>
                        <id>ban-duplicate-classes</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <banDuplicateClasses>
                                    <scopes>
                                        <scope>compile</scope>
                                        <scope>runtime</scope>
                                        <scope>provided</scope>
                                    </scopes>
                                    <findAllDuplicates>true</findAllDuplicates>
                                    <ignoreWhenIdentical>true</ignoreWhenIdentical>
                                    <ignoreClasses>
                                        <!-- uw-httpclient 内置的 uw-task 同包桥接副本（使其不依赖 uw-task，设计如此）：与 uw-task 原类
                                             签名与字节码指令一致，仅源码注释不同致行号表不同 -->
                                        <ignoreClass>uw.task.exception.TaskDataException</ignoreClass>
                                        <ignoreClass>uw.task.exception.TaskPartnerException</ignoreClass>
                                    </ignoreClasses>
                                </banDuplicateClasses>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

